<section class="hero">
  <h1 class="<%= lc_heading_class(size: :display, extra: "hero__title") %>">
    Fix your Rails app<br>
    <span class="pen-mark">in the browser.</span>
  </h1>
  <div class="hero__actions">
    <a class="<%= lc_button_class(size: :lg, extra: "hero__start") %>" href="<%= installation_page_path %>"><span class="glint" aria-hidden="true"><i class="glint__across"></i><i class="glint__down"></i></span>Get started</a>
    <a class="<%= lc_button_class(variant: :outline, size: :lg) %>" href="https://github.com/lostcoords/tensaku" data-umami-event="github" data-umami-event-place="hero"><%= render "shared/github_icon" %>GitHub</a>
  </div>
  <button type="button" class="hero__try" data-demo-try="true">or <span class="hero__try-link">try it on this page</span></button>
</section>

<section class="try">
  <div class="try__guide">
    <ol class="try__steps">
      <li><%= lc_kbd "alt+click", data: { turbo_permanent: true } %> the big heading, choose Edit text, change a word and press Enter. Its source updates too.</li>
      <li><%= lc_kbd "alt+shift+click", data: { turbo_permanent: true } %> anything on this page and write what should change. Your agent gets the note.</li>
    </ol>
    <p class="<%= lc_text_class(size: :small, tone: :muted, extra: "try__touch") %>">On a touch screen, tap the flower in the corner, then Edit.</p>
  </div>
  <%= render "demo/window" %>
</section>

<%= render "pages/agent_stripe" %>

<section class="agents">
  <div class="agents__intro">
    <h2 class="<%= lc_heading_class(size: :title) %>">Collaborate with your <span class="pen-mark">agents</span>!</h2>
    <p class="<%= lc_text_class(size: :small, tone: :muted) %>">Each note carries your comment and the exact file and line you pointed at, and stays on your machine. Your agent picks notes up through MCP, works through them, and answers on the page: done, a question, or why not. In Claude Code, saving a note can start the agent right away. Prefer to paste? Copy your notes as Markdown. <a class="<%= lc_link_class(extra: "text-primary") %>" href="<%= notes_page_path(anchor: "how-agents-read-notes") %>">How agents read notes</a></p>
  </div>
  <%= video_tag "tensaku-demo.mp4", poster: "/tensaku-demo-poster.jpg", class: "demo-video", muted: true, loop: true, playsinline: true, controls: true, preload: "metadata", width: 1920, height: 1080,
        aria: { label: "A note asks for a red button with a glint; Claude Code makes the change and the page updates" }, data: { controller: "demo-video" } %>
</section>

<section class="cta">
  <div class="cta__content">
    <h2 class="<%= lc_heading_class(size: :display, extra: "cta__title") %>">Try it on your own app</h2>
    <p class="cta__text">Add the gem to your development group and restart your server. There is no JavaScript to set up.</p>
    <div class="cta__command">
      <%= lc_code_block "bundle add tensaku --group development\n\n# To connect a coding agent\nbin/rails generate tensaku:install", id: "install-commands", language: "shell", max_lines: nil %>
    </div>
    <div class="cta__actions">
      <a class="<%= lc_button_class(size: :lg, extra: "cta__button") %>" href="<%= installation_page_path %>">Install Tensaku</a>
      <a class="<%= lc_button_class(variant: :ghost, size: :lg, extra: "cta__button cta__button--plain") %>" href="<%= introduction_page_path %>">Read the docs</a>
    </div>
  </div>
  <%= image_tag "hanamaru.svg", alt: "", class: "cta__mark" %>
</section>
