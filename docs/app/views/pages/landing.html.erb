<section class="hero">
  <h1 class="<%= lc_heading_class(size: :display, extra: "hero__title") %>">
    Fix your Rails app<br>
    <span class="pen-mark">in the browser<svg viewBox="0 0 240 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 9 C 45 3, 92 12, 138 7 S 214 4, 237 8"/></svg></span>.
  </h1>
  <div class="hero__actions">
    <button type="button" class="<%= lc_button_class(size: :lg) %>" data-demo-try>Try it on this page</button>
    <a class="<%= lc_button_class(variant: :outline, size: :lg) %>" href="https://github.com/lostcoords/tensaku"><%= render "shared/github_icon" %>GitHub</a>
  </div>
</section>

<section class="try">
  <div class="try__guide">
    <ol class="try__steps">
      <li><%= lc_kbd "alt+click", data: { turbo_permanent: true } %> the big heading, change a word and press Enter. Its source updates too.</li>
      <li>Press <%= lc_kbd "alt+shift+t", data: { turbo_permanent: true } %>, click a card below and choose <strong>Add note</strong>.</li>
    </ol>
    <p class="<%= lc_text_class(size: :small, tone: :muted, extra: "try__touch") %>">On a touch screen, tap 添 in the corner, then Edit.</p>
  </div>
  <%= render "demo/window" %>
</section>

<section class="features">
  <article class="<%= lc_card_class %>">
    <h3 class="<%= lc_heading_class(size: :subheading) %>"><span class="ink-red">Edit</span> text in place</h3>
    <p class="<%= lc_text_class(tone: :muted) %>">The editor shows the source. Ruby stays a locked chip, so you only change the words around it.</p>
  </article>
  <article class="<%= lc_card_class %>">
    <h3 class="<%= lc_heading_class(size: :subheading) %>"><span class="ink-accent">Notes</span> for your agent</h3>
    <p class="<%= lc_text_class(tone: :muted) %>">Point at anything and say what should change. Your agent gets the note with the file and line.</p>
  </article>
  <article class="<%= lc_card_class %>">
    <h3 class="<%= lc_heading_class(size: :subheading) %>"><span class="ink-green">Production</span> stays the same</h3>
    <p class="<%= lc_text_class(tone: :muted) %>">Tensaku only loads in development, and every write touches only the bytes you edited.</p>
  </article>
</section>

<section class="install">
  <h2 class="<%= lc_heading_class(size: :title) %>">Two commands</h2>
  <%= lc_code_block "bundle add tensaku --group development\nbin/rails generate tensaku:install", id: "install-commands", language: "shell", max_lines: nil %>
  <p class="<%= lc_text_class(tone: :muted) %>">Ruby 4.0 or later and Rails 8.1. <a class="<%= lc_link_class(extra: "text-primary") %>" href="<%= introduction_page_path %>">Read the docs</a></p>
</section>
