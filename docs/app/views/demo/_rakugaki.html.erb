<%# Corrections beside the hero, the way a teacher marks a draft (添削). --x is the distance from the hero's edge. %>
<div class="rakugaki" aria-hidden="true">
  <span class="rk rk--left" style="--top: 9.5rem; --x: 3rem; --rot: -6deg"><s>teh</s> the</span>
  <p class="rk rk--left rk--note rk--yellow" style="--top: 13.5rem; --x: 0.5rem; --rot: -4deg">wrong word in the title?</p>
  <span class="rk rk--left rk--squiggle" style="--top: 20.5rem; --x: 4rem; --rot: 3deg">recieve</span>

  <span class="rk rk--right rk--highlight" style="--top: 10rem; --x: 3.5rem; --rot: 3deg">reword this?</span>
  <span class="rk rk--right" style="--top: 14.5rem; --x: 0.5rem; --rot: -3deg">a<span class="rk__caret">^<em>tiny</em></span>fix</span>
  <p class="rk rk--right rk--note rk--pink" style="--top: 18rem; --x: 2rem; --rot: 5deg">fix it here, not in the editor</p>
</div>
