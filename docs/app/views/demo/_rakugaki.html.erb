<%# Corrections around the hero, the way a teacher marks a draft (添削). --a is the angle on the ellipse, clockwise from the right. %>
<div class="rakugaki" aria-hidden="true">
  <span class="rk" style="--a: 215deg; --rot: -8deg"><s>teh</s> the</span>
  <p class="rk rk--note rk--yellow" style="--a: 180deg; --rot: -2deg">wrong text?</p>
  <span class="rk rk--squiggle" style="--a: 145deg; --rot: 8deg">recieve</span>

  <span class="rk rk--highlight" style="--a: -35deg; --rot: 8deg">reword this?</span>
  <span class="rk rk--circled" style="--a: 0deg; --rot: -6deg"><span class="rk__ring">lorem ipsum</span><em>real copy, pls</em></span>
  <p class="rk rk--note rk--pink" style="--a: 35deg; --rot: -8deg">fix it here!</p>
</div>
