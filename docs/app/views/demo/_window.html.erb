<%# The lines of the page's source that the heading comes from, which is what the first step edits. %>
<% lines = File.readlines(Rails.root.join("app/views/pages/landing.html.erb"), chomp: true) %>
<% first = lines.index { it.include?("<h1") } %>
<% last = lines.index { it.include?("</h1>") } %>
<section class="<%= lc_card_class(padding: :none, extra: "window") %>" aria-label="The heading's source" data-demo-chrome>
  <p class="window__bar">app/views/pages/landing.html.erb</p>
  <pre class="window__code" data-demo-source-code data-first-line="<%= first + 1 %>"><%= lines[first..last].join("\n") %></pre>
</section>
