<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8">
    <title>Tensaku: fix your Rails app in the browser</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Edit the text on your running Rails pages and the source updates. Leave notes for your coding agent on anything you see, with the file and line that rendered it.">
    <%= render "shared/social_meta", title: "Tensaku" %>
    <%# The demo's overlay stays on this page: arriving and leaving are full page loads. %>
    <meta name="turbo-visit-control" content="reload">
    <%= favicon_link_tag "hanamaru-small.svg", type: "image/svg+xml" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shantell+Sans:wght@400;600&display=swap">
    <%# Before first paint, so the finished heading doesn't flash before demo/hero.js rewinds it. %>
    <script>if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("hero-anim")</script>
    <%= stylesheet_link_tag "tailwind", "application_header", "landing" %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "demo" %>
    <link rel="preload" href="<%= asset_path("tensaku.js") %>" as="script">
    <%= render "shared/analytics" %>
  </head>
  <body class="landing antialiased" data-turbo="false">
    <%= lc_skip_link %>
    <%= render "shared/site_header" %>
    <%= render "demo/rakugaki" %>
    <main id="main" data-demo data-demo-overlay="<%= asset_path("tensaku.js") %>"><%= yield %></main>
    <footer class="landing-footer">
      <span><a href="https://lostcoords.com">LOSTCOORDS</a> 2026</span>
      <nav class="landing-footer__links" aria-label="Project links">
        <a href="<%= introduction_page_path %>"><%= lc_icon "book-open", options: { "aria-hidden": true } %>Docs</a>
        <a href="https://github.com/lostcoords/tensaku" data-umami-event="github" data-umami-event-place="footer"><%= render "shared/github_icon" %>GitHub</a>
        <a href="https://rubygems.org/gems/tensaku" data-umami-event="rubygems"><%= lc_icon "cube", options: { "aria-hidden": true } %>RubyGems</a>
        <% if (release = Docs.release) %><a href="<%= changelog_page_path %>" aria-label="Version <%= release %>, changelog"><%= lc_icon "tag", options: { "aria-hidden": true } %>v<%= release %></a><% end %>
      </nav>
    </footer>
  </body>
</html>
