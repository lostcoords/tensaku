<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8">
    <title><%= @page ? "#{@page.title} · " : "" %>Tensaku</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Fix your Rails app without leaving the browser.">
    <%= favicon_link_tag "hanamaru-small.svg", type: "image/svg+xml" %>
    <%= stylesheet_link_tag "tailwind", "application_header", "docs_shell", "highlight", data: { turbo_track: "reload" } %>
    <meta name="turbo-prefetch" content="true">
    <%= javascript_importmap_tags %>
  </head>
  <body class="antialiased">
    <%= lc_skip_link %>
    <%= render "shared/site_header", current: @page&.slug == "installation" ? "installation" : "docs" %>
    <% page = platform_keys(yield) %>
    <% outline = Docs.outline(page) %>
    <%= render layout: "shared/docs_shell", locals: { navigation: render("shared/navigation"), contents: (render("shared/outline", outline:) if outline.size > 1), menu_label: "Pages", width: "max-w-3xl" } do %>
      <article class="<%= lc_prose_class %>">
        <%= page %>
      </article>
      <%# Inside the shell, so the sticky sidebars have the whole page to stay in and never slide up under the header. %>
      <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6 text-xs text-muted-foreground">
        <span>Tensaku by <a href="https://lostcoords.com">Lostcoords</a> · MIT license<% if (release = Docs.release) %> · <a href="<%= changelog_page_path %>" aria-label="Version <%= release %>, changelog">v<%= release %></a><% end %></span><%= lc_link "Source on GitHub ↗", "https://github.com/lostcoords/tensaku", tone: :muted, class: "no-underline hover:underline" %>
      </footer>
    <% end %>
  </body>
</html>
