<%# lc_search with results from MiniSearch: docs-search answers lc-search:query and renders rows from the templates. %>
<div class="contents" data-controller="docs-search" data-docs-search-url-value="/search.json" data-action="lc-search:query->docs-search#query">
  <%# The key hint is written in the browser, so the morph after a Tensaku save has to leave it alone. %>
  <%= lc_search label: "Search documentation", placeholder: "Search the docs…", trigger: "Search", data: { turbo_permanent: true } %>
  <template data-docs-search-target="group"><%= lc_search_group "Group" %></template>
  <% DocsSearch::GROUPS.each do |group, icon| %>
    <template data-docs-search-target="result" data-group="<%= group %>"><%= lc_search_result "Title", "#", detail: "", icon: icon %></template>
  <% end %>
</div>
