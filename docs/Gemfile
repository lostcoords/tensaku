source "https://rubygems.org"

# Tensaku's documentation site: a Rails app rendered to static files by Kiln, styled with
# lostcoords-ui. Tensaku itself runs on it in development, so the docs are also where Tensaku is
# tried on a real site.

gem "rails", "~> 8.1.0"
gem "propshaft"
gem "importmap-rails"
gem "turbo-rails"
gem "stimulus-rails"
gem "tailwindcss-rails", "~> 4.4"
gem "puma"

gem "lostcoords-ui", "~> 0.8.2"

# Kiln's content layer and its data-tensaku-md source positions are unreleased (0.1.1).
gem "kiln", path: "../../kiln"
gem "commonmarker", "~> 2.9"
gem "rouge"

group :development do
  gem "tensaku", path: ".."
end
