<h1 class="behind">Behind the dialogs</h1>
<p class="behind-text">Background text that a modal covers.</p>
<button type="button" class="open-modal" onclick="document.getElementById('modal').showModal()">Open dialog</button>
<button type="button" class="open-tip" popovertarget="tip">Open popover</button>
<button type="button" class="open-overlay" onclick="document.getElementById('overlay').style.display = 'grid'">Open CSS modal</button>
<div style="height: 1200px"></div>

<dialog id="modal" style="width: 420px; transform: translateY(8px)" onclick="const r = this.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) this.close()">
  <h2 class="modal-title">Inside the dialog</h2>
  <p class="modal-text">Text in the dialog.</p>
  <button type="button" class="open-nested" onclick="document.getElementById('nested').showModal()">Open nested</button>
  <button type="button" class="close-modal" onclick="this.closest('dialog').close()">Close</button>
  <dialog id="nested"><p class="nested-text">Nested dialog text.</p></dialog>
</dialog>

<div id="tip" popover style="margin: 0; inset: auto 40px 40px auto"><p class="tip-text">Popover text.</p></div>

<div id="overlay" style="display: none; position: fixed; inset: 0; z-index: 50; place-items: center; background: rgba(0, 0, 0, .4)">
  <div class="css-modal" role="dialog" aria-modal="true" style="width: 360px; padding: 24px; background: white"><p class="css-modal-text">CSS modal text.</p></div>
</div>
